<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared-mime-info definition for slopkit address tables. The magic token must
  stay in sync with the first line the serializer writes (src/table/serializer.cpp).
-->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-slopkit-table">
    <comment>slopkit address table</comment>
    <glob pattern="*.skt"/>
    <magic priority="50">
      <match value="slopkit-table" type="string" offset="0"/>
    </magic>
  </mime-type>
</mime-info>
